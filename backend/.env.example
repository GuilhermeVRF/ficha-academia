# Copy to backend/.env for local development (never commit the real .env).
DATABASE_URL=postgresql://pino:pino@localhost:5432/pino
APP_TIMEZONE=America/Sao_Paulo

# Admin account: created/updated on every start; it also owns workouts from before accounts existed.
ADMIN_NAME=Seu nome
ADMIN_EMAIL=voce@example.com
ADMIN_PASSWORD=troque-por-uma-senha-longa
